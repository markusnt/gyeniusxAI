# Ambiente: development | staging | production
ENVIRONMENT=development
DEBUG=false

# CORS - origens permitidas (BFF). Ex: http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Rate limit no endpoint de chat
RATE_LIMIT_CHAT=60/minute

# Chave compartilhada BFF <-> StudyAI-AI. Deve ser igual ao LLM_API_KEY do StudyAI-back.
# Se vazio: não exige autenticação (apenas dev local).
# Gerar: python -c "import secrets; print(secrets.token_urlsafe(32))"
LLM_API_KEY=

# OpenAI (pago) - primeiro na ordem de fallback
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Google Gemini (fallback)
# Obtenha em: https://aistudio.google.com/apikey
GOOGLE_API_KEY=sua-chave-aqui

# Ordem dos provedores: "openai,gemini" = tenta OpenAI primeiro, depois Gemini
LLM_PROVIDERS=openai,gemini